<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Vendor Management</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- DataTables Bootstrap 5 Styling -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css">
    
    <!-- Font Awesome 6 -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">

    <!-- Custom Theme & Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VendorMngSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid px-lg-4">
                <a class="brand-wrapper" asp-area="" asp-controller="Vendors" asp-action="Index">
                    <div class="brand-icon-box">
                        <i class="fa-solid fa-boxes-packing"></i>
                    </div>
                    <div>
                        <h1 class="brand-title">Vendor <span>Management</span></h1>
                    </div>
                </a>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 py-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>



    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- DataTables & Plugins -->
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <!-- Validation -->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- Modern Compact App Modal -->
    <div class="modal fade" id="CommonModalId" tabindex="-1" aria-labelledby="CommonModalHeaderText" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 560px;">
            <div class="modal-content border-0 shadow-xl">
                <div class="modal-header-custom" id="CommonModalHeaderId">
                    <div class="d-flex align-items-center gap-2">
                        <div class="modal-header-icon-sm">
                            <i class="fa-solid fa-building-circle-check"></i>
                        </div>
                        <h6 class="modal-title m-0 fw-bold text-dark" id="CommonModalHeaderText">Add New Vendor</h6>
                    </div>
                    <button type="button" class="btn-close btn-close-sm" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body-custom" id="CommonModalBodyId">
                    <!-- Dynamic form loaded here via AJAX -->
                </div>
            </div>
        </div>
    </div>
</body>
</html>
