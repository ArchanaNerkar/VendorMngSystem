@{
    ViewData["Title"] = "Compliance & Privacy Policy";
}

<div class="page-header-container">
    <div>
        <h2 class="page-header-title">
            <i class="fa-solid fa-shield-halved text-primary"></i>
            <span>Privacy & Compliance Standards</span>
        </h2>
        <p class="page-header-subtitle">
            Enterprise procurement data protection, retention protocols, and confidentiality
        </p>
    </div>
</div>

<div class="table-card p-4">
    <div class="row g-4">
        <div class="col-12 col-md-6">
            <h5 class="fw-bold text-dark mb-2">
                <i class="fa-solid fa-lock text-primary me-2"></i>Data Privacy & Supplier Confidentiality
            </h5>
            <p class="text-muted">
                All vendor records, contact details, tax numbers (GSTIN), and uploaded verification documents are stored securely with strict role-based access control. No supplier data is shared outside authorized procurement personnel.
            </p>
        </div>

        <div class="col-12 col-md-6">
            <h5 class="fw-bold text-dark mb-2">
                <i class="fa-solid fa-folder-check text-success me-2"></i>Document Retention & Integrity
            </h5>
            <p class="text-muted">
                Uploaded certifications and agreement attachments are checksum-verified and retained in adherence to statutory commercial audit requirements. File removals require authorized administrative confirmation.
            </p>
        </div>
    </div>
</div>
